# Database Connection URL:
# For SQLite (default local): leave empty or use sqlite:///path/to/db.db
# For Neon PostgreSQL: postgresql://username:password@ep-subdomain.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Backend Environment Configuration Example
# Exact comma-separated frontend origin(s), without trailing slashes.
# Required when PUBLIC_DEMO_MODE=true (wildcard * is rejected in public demo mode).
# Example for Cloudflare Pages: CORS_ORIGINS=https://dynamic-job-shop-scheduler.pages.dev
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Enable strict public-demo security mode (true/false).
# When true, startup fails if DEMO_ACCESS_TOKEN is missing or < 16 chars, or if CORS_ORIGINS
# is missing or set to *, and interactive API docs (/docs, /redoc, /openapi.json) are disabled.
PUBLIC_DEMO_MODE=false

# Secret token required in X-Demo-Token header for all POST (state-modifying) endpoints.
# Must be at least 16 characters when PUBLIC_DEMO_MODE=true.
DEMO_ACCESS_TOKEN=

# Set to false to disable /docs, /redoc, and /openapi.json even when PUBLIC_DEMO_MODE=false
ENABLE_API_DOCS=true

# Server port (used by Docker / Hugging Face Spaces: 7860, or local dev: 8001)
PORT=8001
